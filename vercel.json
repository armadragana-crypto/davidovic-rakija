{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.davidovicrakija.com" }],
      "destination": "https://davidovicrakija.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.davidovicrakija.com" }],
      "destination": "https://davidovicrakija.com/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "davidovic-rakija.vercel.app" }],
      "destination": "https://davidovicrakija.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "davidovic-rakija.vercel.app" }],
      "destination": "https://davidovicrakija.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [{ "source": "/((?!assets/|google).*)", "destination": "/index.html" }]
}
